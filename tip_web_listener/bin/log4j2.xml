<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="DEBUG">
	<Properties>
		<!-- <Property name="logdir">/WebsiteJobs/tip/log/</Property> -->
		<!--  <Property name="logdir">C://Environment_Paths//TIP//logs//</Property>  -->
		<Property name="logdir">/WebsiteJobs/Mohan/Tip/log/</Property> 
	</Properties>
	<Appenders>
		<RollingFile name="tip_log" fileName="${logdir}/tiplog.log"
			filePattern="${logdir}/tiplog-%i.log">
			<PatternLayout>
				<pattern>[%d{yyyy-MM-dd HH:mm:ss:SSS}] [%p]\t[%t] - %C{1} - %c - %m%n</pattern>
			</PatternLayout>
			<Policies>
				<!-- <TimeBasedTriggeringPolicy interval="1" modulate="true"/>  -->
				 <SizeBasedTriggeringPolicy size="200 MB" /> 
			</Policies>
			 <DefaultRolloverStrategy max="10" /> 
			<DefaultRolloverStrategy>
				<Delete basePath="${logdir}" maxDepth="2">
					<IfFileName glob="*/tiplog-*.log.gz" />
					<IfLastModified age="10d" />
				</Delete>
			</DefaultRolloverStrategy>
	</Appenders>
	<Loggers>
		<Logger name="root" level="debug" additivity="false">
			<AppenderRef ref="tip_log" level="info"/>
		</Logger>		
	
	 
	 <!-- Root Logger -->
		<Root level="debug" additivity="false">
			<AppenderRef ref="tip_log" />
		</Root>
	</Loggers>
</Configuration>