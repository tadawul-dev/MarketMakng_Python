<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      TIP platform: OPEN THIS FILE IN INTELLIJ (File > Open > tip-platform/pom.xml > Open as Project).
      It builds the pure-Java TIP client first, then the listener that depends on it. Opening only
      tip-web-listener/pom.xml cannot resolve tip-client unless you run "mvn install" in tip-client first.
    -->
    <groupId>sa.com.tadawul.website</groupId>
    <artifactId>tip-platform</artifactId>
    <version>2.1.0</version>
    <packaging>pom</packaging>
    <name>TIP platform (client + web listener)</name>

    <modules>
        <module>tip-client</module>
        <module>tip-web-listener</module>
    </modules>

    <properties>
        <!-- 21 = the JDK installed on the build machines today. All code compiles and runs on 21.
             Switch to 25 once a JDK 25 is installed (and selected as Project SDK in IntelliJ). -->
        <java.release>21</java.release>
        <maven.compiler.release>${java.release}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
